{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instantmechanic.online/contracts/events/mechanic.telemetry.updated.schema.json",
  "title": "MechanicTelemetryUpdated",
  "allOf": [{ "$ref": "common.schema.json" }],
  "properties": {
    "event_type": { "const": "mechanic.telemetry.updated" },
    "mechanic_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["ONLINE", "OFFLINE", "ON_JOB"] },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "h3_res8_index": { "type": "string", "pattern": "^[0-9a-f][8][0-9a-f]{13}$" },
    "h3_res7_index": { "type": "string", "pattern": "^[0-9a-f][7][0-9a-f]{13}$" },
    "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "heading": { "type": "number", "minimum": 0, "maximum": 360 },
    "speed_kmh": { "type": "number", "minimum": 0 }
  },
  "required": ["mechanic_id", "status", "lat", "lon", "h3_res8_index", "h3_res7_index", "skills"]
}
