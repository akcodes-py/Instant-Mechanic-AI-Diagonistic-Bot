{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instantmechanic.online/contracts/events/diagnosis.completed.schema.json",
  "title": "DiagnosisCompleted",
  "allOf": [{ "$ref": "common.schema.json" }],
  "properties": {
    "event_type": { "const": "diagnosis.completed" },
    "required_skill": {
      "type": "string",
      "enum": ["battery_jumpstart", "tyre_puncture", "engine_overheat", "towing", "brakes", "fuel", "key_lockout", "general_repair"]
    },
    "urgency": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "summary": { "type": "string", "maxLength": 1000 },
    "recommended_service": { "type": "string" },
    "photo_url": { "type": "string", "format": "uri-reference" },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "box": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "reliable": { "type": "boolean" }
        },
        "required": ["label", "confidence", "reliable"]
      }
    },
    "vehicle": { "type": "object" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "h3_res7_index": { "type": "string", "pattern": "^[0-9a-f][7][0-9a-f]{13}$" },
    "customer_phone": { "type": "string", "pattern": "^(\\+91)?[6-9][0-9]{9}$" },
    "ai_used": { "type": "boolean" }
  },
  "required": ["event_type", "required_skill", "urgency", "summary", "lat", "lon", "h3_res7_index"]
}
