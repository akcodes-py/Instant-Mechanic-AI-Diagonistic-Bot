# Copy to .env (never commit real secrets). Frontend must NEVER see these.
DEBUG=False
DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3
MEDIA_ROOT=./media
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=False
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_S=20
MAX_IMAGE_MB=10
MAX_AUDIO_MB=15
MAX_VIDEO_MB=50
CHAT_RATELIMIT_PER_MIN=30

# Optional ML inference: off by default, every failure falls back safely.
ENABLE_ML_INFERENCE=False
VISION_MODEL_PATH=
VISION_CONF=0.25
VISION_IMGSZ=960
NLP_MODEL_PATH=

# H3 dispatch platform (ADR-001). All optional; the app works without them.
H3_PRESENCE_RESOLUTION=8
H3_ZONE_RESOLUTION=7
DISPATCH_MAX_RING=3
OFFER_TTL_SECONDS=15
REDPANDA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=instant_mechanic
ENABLE_MONGO=False
MONGO_TIMEOUT_MS=500
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=instant-mechanic-media
DISPATCH_SERVICE_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000
ENABLE_ML_RANKING=False
ETA_MODEL_PATH=

