# Copy to .env (never commit real secrets). Frontend must NEVER see these.
DEBUG=False
DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3
MEDIA_ROOT=./media
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=False
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_S=20
MAX_IMAGE_MB=10
MAX_AUDIO_MB=15
MAX_VIDEO_MB=50
CHAT_RATELIMIT_PER_MIN=30

# Optional ML inference: off by default, every failure falls back safely.
ENABLE_ML_INFERENCE=False
VISION_MODEL_PATH=
VISION_CONF=0.25
VISION_IMGSZ=960
NLP_MODEL_PATH=
